# ==============================================================
# Uyda Telegram Bot & OLX Monitor Environment Configuration
# ==============================================================

# Telegram Bot Token (obtain from @BotFather)
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Comma-separated Telegram User IDs with admin access
ADMIN_IDS=123456789,987654321

# Telegram Channel username (e.g. @joyliy_channel) or numeric ID (-100...) for broadcasting
CHANNEL_ID=

# Database Connection (PostgreSQL asyncpg)
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<db_name>
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/uyda
DB_ECHO=false

# Monitor & Polling Configuration
POLL_INTERVAL_SECONDS=600
OLX_SEARCH_URLS=https://www.olx.uz/nedvizhimost/kvartiry/arenda-dolgosrochnaya/tashkent/

# Provider Type: 'auto', 'olx_http', 'fixture', or 'feed'
PROVIDER_TYPE=auto

# Reference exchange rate for listings quoted in USD
USD_TO_UZS_RATE=12800.0

# Rate Limiting & Notification Settings
MAX_NOTIFICATIONS_PER_SECOND=25.0
BATCH_SIZE=10

# REST API & Website Integration
HOST=0.0.0.0
PORT=8000
API_KEY=your-secure-random-api-key-here

# Logging Level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

